# Copy to .env.local (gitignored) for local dev. In production these are
# baked in at build time from GitHub Actions secrets — see .github/workflows/deploy.yml.
# Both values are public by Supabase's own design: the anon key is safe to
# ship in client JS because every table is locked down by Row Level Security.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
